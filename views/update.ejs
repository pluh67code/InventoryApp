<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poop Keys || Update Board</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header"><a href="/">Poop Keys</a></header>
    <main class="container narrow">
        <section class="card">
            <h1>Update Keyboard</h1>
            <% if (locals.errors) { %>
                <ul class="errors">
                    <% errors.forEach(err => { %>
                        <li><%= err.msg %></li>
                    <% }) %>
                </ul>
            <% } %>

            <form action="/keyboards/update/<%= keyboard.id %>" method="post" class="form">
                <label for="name">Name: </label>
                <input type="text" id="name" name="name" required maxlength="50" value="<%= keyboard.name %>">

                <label for="stock">Stock: </label>
                <input type="number" id="stock" name="stock" required min="0" max="10000" step="1" value="<%= keyboard.stock %>">

                <label for="brand">Brand: </label>
                <input type="text" id="brand" name="brand" required maxlength="50" value="<%= keyboard.brand %>">

                <label for="size">size (%): </label>
                <select id="size" name="size">
                    <% [60, 75, 80, 100].forEach(size => { %>
                        <option value="<%= size %>" <%= keyboard.size == size ? "selected" : "" %>><%= size %>%</option>
                    <% }) %>
                </select>

                <label for="switchType">Switch type: </label>
                <select id="switchType" name="switchType">
                    <% ["thocky", "silent"].forEach(switchType => { %>
                        <option value="<%= switchType %>" <%= keyboard.switchType === switchType ? "selected" : "" %>><%= switchType %></option>
                    <% }) %>
                </select>

                <label for="connectionType">connection type: </label>
                <select id="connectionType" name="connectionType">
                    <% ["wired", "wireless"].forEach(connectionType => { %>
                        <option value="<%= connectionType %>" <%= keyboard.connectionType === connectionType ? "selected" : "" %>><%= connectionType %></option>
                    <% }) %>
                </select>

                <div class="actions">
                    <button class="btn btn-primary" type="submit">Update Keyboard</button>
                    <a class="btn" href="/keyboards/keyboard/<%= keyboard.id %>">Back</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>