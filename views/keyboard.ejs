<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poop Keys | View Board</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header"><a href="/">Poop Keys</a></header>
    <main class="container narrow">
        <article class="card">
            <h1><%= keyboard.name %></h1>
            <p class="subtitle">by <%= keyboard.brand %></p>
            <div class="tags">
                <span class="tag"><%= keyboard.size %>%</span>
                <span class="tag"><%= keyboard.switchType %></span>
                <span class="tag"><%= keyboard.connectionType %></span>
            </div>
            <p>Stock: <%= keyboard.stock %></p>

            <div class="actions">
                <a class="btn btn-primary" href="/keyboards/update/<%= keyboard.id %>">Update</a>
                <a class="btn btn-danger" href="/keyboards/delete/<%= keyboard.id %>">Delete</a>
                <a class="btn" href="/keyboards">Back</a>
            </div>
        </article>
    </main>
</body>
</html>
