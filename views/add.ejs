<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poop Keys | Add Keyboard</title>
</head>
<body>
    <form action="/keyboards/add" method="post">
        <label for="name">Name: </label>
        <input type="text" id="name" name="name">

        <label for="stock">Stock: </label>
        <input type="number" id="stock" name="stock">

        <label for="brand">brand: </label>
        <input type="text" id="brand" name="brand">

        <label for="size">size (%): </label>
        <input type="number" id="size" name="size">

        <label for="switchType">Switch type: </label>
        <input type="text" id="switchType" name="switchType">

        <label for="connectionType">connection type: </label>
        <input type="text" id="connectionType" name="connectionType">

        <button type="submit">Add Keyboard</button>
    </form>
</body>
</html>