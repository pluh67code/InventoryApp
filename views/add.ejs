<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poop Keys | Add Keyboard</title>
</head>
<body>
    <form action="/keyboards/add" method="post">
        <label for="name">Name: </label>
        <input type="text" id="name" name="name" required maxlength="50">

        <label for="stock">Stock: </label>
        <input type="number" id="stock" name="stock" required min="0" max="10000" step="1">

        <label for="brand">brand: </label>
        <input type="text" id="brand" name="brand" required maxlength="50">

        <label for="size">size (%): </label>
        <select id="size" name="size">
            <option value="60">60%</option>
            <option value="75">75%</option>
            <option value="80">80%</option>
            <option value="100">100%</option>
        </select>

        <label for="switchType">Switch type: </label>
        <select id="switchType" name="switchType">
            <option value="thocky">thocky</option>
            <option value="silent">silent</option>
        </select>

        <label for="connectionType">connection type: </label>
        <select id="connectionType" name="connectionType">
            <option value="wired">wired</option>
            <option value="wireless">wireless</option>
        </select>

        <button type="submit">Add Keyboard</button>
    </form>
</body>
</html>