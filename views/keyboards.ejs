<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poop Keys | Keyboards</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header"><a href="/">Poop Keys</a></header>
    <main class="container">
        <div class="page-header">
            <div>
                <h1>Keyboards</h1>
                <p class="subtitle">These are le boards</p>
            </div>
            <div class="actions">
                <a class="btn" href="/">Back to home page</a>
                <a class="btn btn-primary" href="/keyboards/add">Add a keyboard</a>
            </div>
        </div>

        <% if (keyboards.length === 0) { %>
            <p class="card empty">No keyboards yet. Add one!</p>
        <% } %>

        <div class="card-grid">
            <% for (let keyboard of keyboards) { %>
                <article class="card">
                    <h2><%= keyboard.name %></h2>
                    <p class="subtitle">by <%= keyboard.brand %></p>
                    <div class="tags">
                        <span class="tag"><%= keyboard.size %>%</span>
                        <span class="tag"><%= keyboard.switchType %></span>
                        <span class="tag"><%= keyboard.connectionType %></span>
                    </div>
                    <p>Stock: <%= keyboard.stock %></p>
                    <div class="actions">
                        <a class="btn" href="/keyboards/keyboard/<%= keyboard.id %>">More</a>
                        <a class="btn btn-danger" href="/keyboards/delete/<%= keyboard.id %>">Delete</a>
                    </div>
                </article>
            <% } %>
        </div>
    </main>
</body>
</html>
